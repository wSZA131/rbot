<?xml version="1.0"?>
<sdf version="1.11">
  <model name="backpack">
    <!-- Solid body for volume plus a thin photo plate on the front face.
         Wrapping the photo around the whole box distorts it and kills
         open-vocabulary detection; a flat plate keeps the photo undistorted.
         Plate aspect (0.30 x 0.45) matches the source photo (512 x 762). -->
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.22 0.30 0.45</size></box></geometry>
      </collision>

      <visual name="body">
        <geometry><box><size>0.22 0.30 0.45</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.12 1</ambient>
          <diffuse>0.14 0.14 0.17 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="photo">
        <pose>0.111 0 0 0 0 0</pose>
        <geometry><box><size>0.002 0.30 0.45</size></box></geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>model://backpack/materials/textures/backpack_albedo.png</albedo_map>
              <roughness>0.75</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

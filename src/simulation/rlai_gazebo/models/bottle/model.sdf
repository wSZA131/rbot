<?xml version="1.0"?>
<sdf version="1.11">
  <model name="bottle">
    <!-- Photo plate sized for the detector: a real 0.24 m bottle is only about
         40 px at 1.5 m range, which is below what the model can resolve. -->
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.14 0.18 0.27</size></box></geometry>
      </collision>

      <visual name="body">
        <geometry><box><size>0.14 0.18 0.27</size></box></geometry>
        <material>
          <ambient>0.45 0.62 0.58 1</ambient>
          <diffuse>0.60 0.80 0.74 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <visual name="photo">
        <pose>0.071 0 0 0 0 0</pose>
        <geometry><box><size>0.002 0.18 0.27</size></box></geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>model://bottle/materials/textures/bottle_albedo.png</albedo_map>
              <roughness>0.35</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

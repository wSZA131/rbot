<?xml version="1.0"?>
<sdf version="1.11">
  <model name="cardboard_box">
    <!-- Box body plus an undistorted photo plate on the front face. -->
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.30 0.28 0.42</size></box></geometry>
      </collision>

      <visual name="body">
        <geometry><box><size>0.30 0.28 0.42</size></box></geometry>
        <material>
          <ambient>0.45 0.32 0.16 1</ambient>
          <diffuse>0.70 0.50 0.26 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="photo">
        <pose>0.151 0 0 0 0 0</pose>
        <geometry><box><size>0.002 0.28 0.42</size></box></geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>model://cardboard_box/materials/textures/cardboard_box_albedo.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
